{
  "name": "@pe/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit",
