flowchart TD
    a([Игрок входит]) --> b[Находит комнату или создаёт её]
    b --> c[Входит в лобби]
    c --> d{Участников минимум трое?}
    d -- Нет --> c
    d -- Да --> e[Хост выбирает луп и запускает раунд]
    e --> f[Участники сочиняют и сохраняют риффы]
    f --> g{Время сочинения истекло?}
    g -- Нет --> f
    g -- Да --> h[Анонимное прослушивание и голосование]
    h --> i{Время голосования истекло?}
    i -- Нет --> h
    i -- Да --> j[Показать авторов, голоса и победителей]
    j --> k([Раунд завершён])
