{
  "name": "pe-monorepo",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @pe/frontend dev",
    "dev:backend": "uv run --project backend uvicorn app.main:app --app-dir backend/src --reload --port 8000",
    "build": "pnpm --filter @pe/frontend build",
    "typecheck": "pnpm --filter @pe/frontend typecheck",
    "lint": "pnpm --filter @pe/frontend lint",
    "lint:fsd": "pnpm --filter @pe/frontend lint:fsd",
    "lint:backend": "uv run --project backend --locked ruff check backend scripts && uv run --project backend --locked ruff format --check backend scripts",
    "test:backend": "uv run --project backend pytest backend/tests",
    "test:frontend": "pnpm --filter @pe/frontend test",
    "lighthouse": "pnpm --filter @pe/frontend lighthouse",
    "lighthouse:check": "pnpm --filter @pe/frontend lighthouse:check",
    "storybook": "pnpm --filter @pe/frontend storybook",
    "storybook:build": "pnpm --filter @pe/frontend storybook:build"
  },
  "dependencies": {
    "konva": "^10.9.1",
    "react-konva": "^19.3.2",
    "tone": "^15.1.22"
  }
}
