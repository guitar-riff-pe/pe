# Docker Compose; copy to .env to override local defaults.
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Empty uses the browser's hostname on port 8000 (keeps cookies same-site).
VITE_API_URL=
POSTGRES_DB=pe
POSTGRES_USER=pe
POSTGRES_PASSWORD=pe_local_password
# Generate a persistent random signing key (at least 32 characters).
JWT_SECRET=
AUTH_COOKIE_SECURE=false
